# Claude（Anthropic API）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Google
DRIVE_ROOT_FOLDER_ID=
SPREADSHEET_ID=
SHEET_NAME=支払い一覧
GMAIL_ACCOUNT=
# file = drive.file（最小権限・このアプリが作ったフォルダのみ） / full = drive（既存フォルダを使う場合）
DRIVE_SCOPE=file
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# 動作設定
TIMEZONE=Asia/Tokyo
INVOICE_CONFIDENCE_THRESHOLD=0.80
SCAN_DAYS=30
